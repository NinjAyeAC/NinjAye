root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,hpp}]
indent_size = 4

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{json,yml,yaml,sql,ps1}]
indent_size = 2

[*.{sln,vcxproj,vcxproj.filters}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
